# ============================================================================
# AEGIS-1 — contoh konfigurasi
# Salin menjadi .env lalu isi. File .env TIDAK boleh di-commit (.gitignore).
#
# PERINGATAN: paket AEGIS-1 ini berjalan PAPER (simulasi). LIVE_MODE=true akan
# DITOLAK dengan sengaja sebelum menyentuh jaringan. Lihat README bagian
# "Batas paket". Jangan pernah menaruh nilai key/secret di file ini bila file
# ini akan dibagikan.
# ============================================================================

# --- Mode -------------------------------------------------------------------
# false = paper/safe (satu-satunya mode yang berjalan di paket ini)
# true  = akan ditolak: adapter eksekusi live tidak disertakan
AEGIS_LIVE_MODE=false

# --- Instrumen --------------------------------------------------------------
AEGIS_SYMBOL=BTC/USDT
AEGIS_TIMEFRAME=15m
AEGIS_MARKET=crypto
AEGIS_EXCHANGE=binance
AEGIS_QUOTE_CURRENCY=USDT
AEGIS_INITIAL_EQUITY=10000

# --- Sumber data ------------------------------------------------------------
# true  = data sintetis (tanpa jaringan, untuk demo & uji)
# false = ccxt endpoint publik (read-only, tanpa kredensial)
AEGIS_OFFLINE=false

# --- Risiko (fraksi dari equity) -------------------------------------------
AEGIS_RISK_PER_TRADE=0.01
AEGIS_MAX_OPEN_POSITIONS=3
AEGIS_MAX_TOTAL_EXPOSURE=0.20
AEGIS_MAX_DAILY_LOSS=0.03
AEGIS_MAX_DRAWDOWN=0.10
AEGIS_MIN_REWARD_RISK=2.0
AEGIS_MAX_LEVERAGE=1.0
AEGIS_MAX_SPREAD_BPS=8.0

# --- Strategi ---------------------------------------------------------------
AEGIS_EMA_FAST=50
AEGIS_EMA_SLOW=200
AEGIS_MIN_BARS=260
AEGIS_MIN_CONFLUENCE=0.70

# --- Eksekusi / aturan instrumen -------------------------------------------
AEGIS_SLIPPAGE_BPS=1.5
AEGIS_STEP_SIZE=0.00001
AEGIS_MIN_NOTIONAL=5.0

# --- Dashboard --------------------------------------------------------------
AEGIS_DASHBOARD_HOST=127.0.0.1
AEGIS_DASHBOARD_PORT=8787
AEGIS_DASHBOARD_ENABLED=true

# --- Penyimpanan ------------------------------------------------------------
AEGIS_DB_PATH=data/aegis1.sqlite3
AEGIS_JSONL_PATH=data/aegis1.jsonl
AEGIS_KILL_SWITCH_FILE=data/KILL_SWITCH
AEGIS_LOOP_INTERVAL_S=5

# --- Instrumen: metadata untuk pembulatan & satuan --------------------------
# Penting bila pindah dari crypto ke forex/saham. Untuk EURUSD misalnya:
#   AEGIS_TICK_SIZE=0.00001  AEGIS_STEP_SIZE=1000  AEGIS_PIP_SIZE=0.0001
AEGIS_TICK_SIZE=0.01
AEGIS_STEP_SIZE=0.00001
AEGIS_MIN_QTY=0.00001
AEGIS_MIN_NOTIONAL=5
AEGIS_PIP_SIZE=0.0001
AEGIS_PRICE_DECIMALS=2
AEGIS_QUOTE_CURRENCY=USDT

# --- Spread dari data -------------------------------------------------------
# Bila CSV punya kolom bid/ask atau spread, nilai itu dipakai. Kalau tidak,
# spread diambil dari AEGIS_SPREAD_BPS. Data lama (replay) tetap memakai
# kolomnya sendiri.
AEGIS_USE_DATA_SPREAD=true
AEGIS_SPREAD_BPS=1.0

# --- Biaya (samakan dengan tarif akun Anda) ---------------------------------
AEGIS_MAKER_FEE=0.0002
AEGIS_TAKER_FEE=0.0005
AEGIS_SLIPPAGE_BPS=1.5

# --- Replay historis --------------------------------------------------------
# REPLAY=true + --csv = jalankan bar demi bar dengan jam mengikuti bar.
# AEGIS_VOLUME_FALLBACK mengisi kolom volume yang tidak ada (mis. 1).
AEGIS_REPLAY=false
AEGIS_REPLAY_BARS=1
AEGIS_VOLUME_FALLBACK=

# --- Kecerdasan analisis ----------------------------------------------------
# MTF: konfirmasi timeframe lebih tinggi (15m -> 1h bila faktor 4).
# Divergensi RSI menaikkan ambang konfluensi +0.10, bukan memblokir entry.
# Pola candle (engulfing/hammer/shooting star) jadi satu suara berbobot kecil.
# Squeeze memberi bonus 0.05 saat breakout dari kompresi volatilitas.
AEGIS_MTF_ENABLED=true
AEGIS_MTF_FACTOR=4
AEGIS_DIVERGENCE_ENABLED=true
AEGIS_PATTERN_ENABLED=true
AEGIS_SQUEEZE_ENABLED=true

# --- Risiko adaptif ---------------------------------------------------------
# Pengali = kualitas sinyal x volatilitas x drawdown x expectancy terakhir,
# dijepit di [RISK_MIN_MULT, RISK_MAX_MULT]. Tidak melewati guardrail keras.
AEGIS_ADAPTIVE_RISK=true
AEGIS_RISK_MIN_MULT=0.25
AEGIS_RISK_MAX_MULT=1.50
AEGIS_RISK_VOL_PENALTY=0.35
AEGIS_DIRECTIONAL_CAP=0.12
AEGIS_BREAKEVEN_AFTER_R=1.0
AEGIS_MAX_BARS_IN_TRADE=0

# --- Filter sesi & batas harian (anti-overtrading) --------------------------
# AEGIS_SESSIONS berisi jendela UTC, boleh lebih dari satu, boleh melewati
# tengah malam. Kosongkan untuk 24/7. AEGIS_MAX_TRADES_PER_DAY=0 berarti bebas.
AEGIS_SESSIONS=
AEGIS_SESSION_FILTER=false
AEGIS_SKIP_WEEKEND=false
AEGIS_MAX_TRADES_PER_DAY=0

# --- Eksekusi live (default MATI) -------------------------------------------
# Membaca blok ini tidak mengaktifkan apa pun. Untuk benar-benar mengirim
# order nyata, SEMUA baris di bawah harus dipenuhi sekaligus:
#   LIVE_MODE=true, LIVE_ACK berisi frasa persis, kredensial terisi,
#   LIVE_SYMBOLS terisi, dan LIVE_DRY_RUN=false.
# Mulai selalu dengan dry_run=true: order divalidasi dan dicatat, tidak dikirim.
AEGIS_LIVE_MODE=false
AEGIS_LIVE_DRY_RUN=true
AEGIS_LIVE_ACK=
AEGIS_LIVE_SYMBOLS=
AEGIS_LIVE_MAX_ORDER_NOTIONAL=100
AEGIS_LIVE_ALLOW_MARKET=false

# ============================================================================
# KREDENSIAL EXCHANGE
# ----------------------------------------------------------------------------
# Paket ini tidak memuat kode yang memakai kredensial untuk mengirim order.
# Variabel di bawah hanya DIBACA STATUS KEBERADAANNYA (terisi / kosong) oleh
# config.credential_presence(); nilainya tidak pernah dimuat ke log, database,
# dashboard, atau dicetak ke layar.
#
# Biarkan kosong untuk paper. Untuk live, isi dengan API key Binance berizin
# SPOT TRADING saja (withdrawal dimatikan) + IP whitelist, dan simpan di secret
# manager VPS — bukan di file yang ikut ter-commit. Modul live.py membaca
# nilainya dari environment dan tidak pernah menuliskannya ke log atau database.
# ============================================================================
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=
